{
  "name": "fyws-frostbound",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:production": "node tests/production.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:combat": "node tests/combat.mjs",
    "test:foundation": "node tests/foundation.mjs",
    "preview:survivor": "node tests/preview-survivor.mjs",
    "asset:survivor": "tsx tools/generate-survivor.ts",
    "test:presentation": "node tests/presentation.mjs",
    "test:settlement": "node tests/settlement.mjs",
    "test:projectiles": "node tests/projectiles.mjs",
    "test:recovery": "node tests/recovery.mjs",
    "test:hits": "node tests/hits.mjs",
    "test:expansion": "node tests/expansion.mjs",
    "test:guards": "node tests/guard-shelter.mjs",
    "test:wilderness": "node tests/wilderness.mjs",
    "test:camp": "node tests/camp-progression.mjs",
    "test:spawn": "node tests/spawn-visibility.mjs",
    "test:night": "node tests/balance-night.mjs",
    "test:workers": "node tests/worker-pause.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
